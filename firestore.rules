rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User Profiles (Email & Password Authentication)
    match /users/{userId} {
      // Allow reading profiles (required for username availability checks)
      allow read: if true;
      
      // Allow authenticated users to create or update their own profile document
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Exam Attempts & Score Saving
    match /attempts/{attemptId} {
      // Allow saving and reading exam scores for both registered users and guests
      allow read, write: if true;
    }
  }
}
